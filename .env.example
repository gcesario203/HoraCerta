# Copie para desenvolvimento: cp .env.example .env

# PostgreSQL (docker compose)
POSTGRES_USER=horacerta
POSTGRES_PASSWORD=horacerta
POSTGRES_DB=horacerta

# pgAdmin (docker compose) — http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@horacerta.dev
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# API
JWT_KEY=HoraCerta-Dev-Secret-Key-Min-32-Chars!!

# Web — docker compose (hostname interno da API)
API_URL=http://api:8080

# Web — botão wa.me (somente dígitos E.164, sem +)
# Obrigatório no build do container web para exibir "Agendar no WhatsApp"
NEXT_PUBLIC_WHATSAPP_NUMERO=

# Web — npm run dev local (src/horacerta-web/.env.local):
# API_URL=http://localhost:5080
# NEXT_PUBLIC_WHATSAPP_NUMERO=5511999999999

# Twilio WhatsApp (API — docker compose mapeia para Twilio__*)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# ngrok http 5080 — base pública (sem path; ver integracao-whatsapp/spec.md)
TWILIO_WEBHOOK_BASE_URL=https://SEU-SUBDOMINIO.ngrok-free.app
# Twilio "When a message comes in": {TWILIO_WEBHOOK_BASE_URL}/api/webhooks/twilio/whatsapp
TWILIO_SESSAO_EXPIRACAO_HORAS=24
# false em dev local/docker sem tunnel; true em produção com HTTPS
TWILIO_VALIDAR_ASSINATURA=false

# Outbox / WhatsApp (opcional — defaults no appsettings.Docker.json)
OUTBOX_INTERVALO_SEGUNDOS=5
OUTBOX_MAX_TENTATIVAS=5
OUTBOX_LOTE_MAXIMO=20
WHATSAPP_SILENCIO_INICIO=22:00
WHATSAPP_SILENCIO_FIM=08:00
WHATSAPP_FUSO_HORARIO=America/Sao_Paulo
